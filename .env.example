# Skatta v2 — Variables d'environnement
# Copier ce fichier en `.env.local` (jamais commité) et remplir les valeurs.
# Voir SETUP.md pour obtenir chaque clé.

# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TON-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-publique

# Resend (optionnel) — https://resend.com/api-keys
# Sans cette clé, les e-mails de notification sont simplement ignorés
# (la candidature fonctionne quand même, visible dans le tableau de bord).
RESEND_API_KEY=
# Adresse d'envoi des e-mails (domaine vérifié dans Resend).
RESEND_FROM=Skatta <notifications@skatta.ga>
