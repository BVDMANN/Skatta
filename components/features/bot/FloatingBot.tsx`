"use client";
import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { MessageCircle, Send, Mic, X, Sparkles } from 'lucide-react';
import { cn } from '@/lib/utils';

export const FloatingBot = () => {
  const [isOpen, setIsOpen] = useState(false);
  const [messages, setMessages] = useState<{role: 'bot' | 'user', text: string}[]>([
    { role: 'bot', text: "Saluuuu chef ! 👋 Je suis ton guide Skatta. Tu cherches un bon plan ou tu veux recruter un gars sérieux ? Dis-moi tout, on gère ça vite !" }
  ]);
  const [input, setInput] = useState('');
  const [isLoading, setIsLoading] = useState(false);

  const API_KEY = "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";

  const handleSend = async () => {
    if (!input.trim()) return;

    const userMsg = input;
    setInput('');
    setMessages(prev => [...prev, { role: 'user', text: userMsg }]);
    setIsLoading(true);

    try {
      const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${API_KEY}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          model: "llama-3.3-70b-versatile",
          messages: [
            {
              role: "system",
              content: "Tu es l'assistant de Skatta, une app premium pour le travail journalier au Gabon. Ton ton est naturel, amical, très 'ndoss' (argot gabonais léger), encourageant et professionnel. Tu aides les jeunes à trouver du travail et les employeurs à recruter. Tu es concis, direct et chaleureux. Utilise des expressions comme 'Chef', 'C'est carré', 'On gère ça'. Ne sois pas un robot, sois un grand frère qui connaît tout Libreville et Port-Gentil."
            },
            ...messages.map(m => ({ role: m.role === 'bot' ? 'assistant' : 'user', content: m.text })),
            { role: "user", content: userMsg }
          ]
        })
      });

      const data = await response.json();
      const botText = data.choices[0].message.content;
      setMessages(prev => [...prev, { role: 'bot', text: botText }]);
    } catch (e) {
      setMessages(prev => [...prev, { role: 'bot', text: "Désolé chef, j'ai un petit bug. On réessaie dans deux secondes !" }]);
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="fixed bottom-28 right-6 z-[100]">
      <AnimatePresence>
        {isOpen && (
          <motion.div
            initial={{ opacity: 0, scale: 0.8, y: 20 }}
            animate={{ opacity: 1, scale: 1, y: 0 }}
            exit={{ opacity: 0, scale: 0.8, y: 20 }}
            className="glass w-[350px] h-[550px] rounded-[2.5rem] shadow-2xl flex flex-col overflow-hidden border border-white/40 mb-6"
          >
            <div className="bg-skatta-green p-6 text-white flex justify-between items-center">
              <div className="flex items-center gap-3">
                <div className="p-2 bg-white/20 rounded-2xl">
                  <Sparkles size={22} className="text-skatta-yellow" />
                </div >
                <div className="flex flex-col">
                  <span className="font-black text-lg block leading-none">Skatta Bot</span>
                  <span className="text-[10px] font-medium opacity-80">En ligne pour toi, Chef !</span>
                </div >
              </div >
              <button onClick={() => setIsOpen(false)} className="p-2 hover:bg-white/10 rounded-full transition-colors">
                <X size={20} />
              </button>
            </div >

            <div className="flex-1 overflow-y-auto p-6 space-y-4 no-scrollbar bg-gradient-to-b from-white to-skatta-ghost">
              {messages.map((msg, i) => (
                <motion.div
                  key={i}
                  initial={{ opacity: 0, scale: 0.9, x: msg.role === 'user' ? 10 : -10 }}
                  animate={{ opacity: 1, scale: 1, x: 0 }}
                  className={cn(
                    "max-w-[85%] p-4 rounded-2xl text-sm leading-relaxed shadow-sm",
                    msg.role === 'user'
                      ? "bg-skatta-blue text-white ml-auto rounded-tr-none"
                      : "bg-white text-skatta-blue mr-auto rounded-tl-none border border-gray-100"
                  )}
                >
                  {msg.text}
                </motion.div>
              ))}
              {isLoading && (
                <div className="flex gap-1 p-4 mr-auto bg-gray-100 rounded-2xl rounded-tl-none">
                  <div className="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:-0.3s]" />
                  <div className="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:-0.15s]" />
                  <div className="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" />
                </div >
              )}
            </div >

            <div className="p-6 bg-white border-t border-gray-100 flex gap-3 items-center">
              <button className="p-3 text-gray-400 hover:text-skatta-green transition-all hover:bg-skatta-green/5 rounded-full">
                <Mic size={22} />
              </button>
              <div className="relative flex-1">
                <input
                  value={input}
                  onChange={(e) => setInput(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && handleSend()}
                  className="w-full bg-gray-100 border-none rounded-2xl py-3 px-4 text-sm outline-none focus:ring-2 focus:ring-skatta-green/30 transition-all"
                  placeholder="Pose ta question, Chef..."
                />
              </div >
              <button
                onClick={handleSend}
                disabled={isLoading}
                className="p-3 bg-skatta-green text-white rounded-2xl shadow-lg shadow-skatta-green/30 active:scale-90 transition-all disabled:opacity-50"
              >
                <Send size={20} />
              </button>
            </div >
          </motion.div>
        )}
      </AnimatePresence>

      <motion.button
        whileHover={{ scale: 1.1, rotate: 5 }}
        whileTap={{ scale: 0.9 }}
        onClick={() => setIsOpen(!isOpen)}
        className="w-16 h-16 rounded-full bg-skatta-green text-white shadow-[0_8px_30px_rgb(0,128,0,0.4)] flex items-center justify-center cursor-pointer border-4 border-white hover:shadow-skatta-green/50 transition-all duration-300"
      >
        <div className="relative">
          <MessageCircle size={32} />
          <span className="absolute -top-1 -right-1 w-3 h-3 bg-skatta-yellow rounded-full border-2 border-white animate-pulse" />
        </div >
      </motion.button>
    </div >
  );
};
